<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Filter</key>
	<dict>
		<!-- Several filter types: without Mode=Any ALL of them must match
		     (UIKit loaded AND executable named appstored), i.e. nothing. -->
		<key>Mode</key>
		<string>Any</string>
		<key>Bundles</key>
		<array>
			<string>com.apple.UIKit</string>
		</array>
		<key>Executables</key>
		<array>
			<string>appstored</string>
		</array>
	</dict>
</dict>
</plist>
